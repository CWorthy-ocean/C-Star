# gpu-ucla-roms v0.1.2-beta built and linked with this set on 2026-11-06.
gpu/1.0  # NERSC's GPU meta-module; keep loaded for CUDA-aware cray-mpich
PrgEnv-nvidia/8.7.0
nvidia/26.5  # PrgEnv-nvidia/8.7.0 loads nvidia/25.9 (CUDA 13.0), whose link misses
             # cudatoolkit/13.2's math libraries (-lcublas); 26.5 ships CUDA 13.2
cudatoolkit/13.2
craype-accel-nvidia80
cray-hdf5-parallel/1.14.3.9
cray-netcdf-hdf5parallel/4.9.0.13
