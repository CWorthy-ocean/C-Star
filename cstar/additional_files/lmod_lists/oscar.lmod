# Oscar (Brown CCV): hierarchical, spack-built Lmod. The MPI module must be loaded
# first; the *-mpi libraries built against it only appear afterwards. Names are from
# https://docs.ccv.brown.edu/oscar/sys-changes/rhel-9.6-module-migration-guide and
# are UNVERIFIED on the machine as of 2026-11-09 (nobody on our side has an account):
# confirm each with `module spider <name>` and adjust.
hpcx-mpi/2.25.1s  # site-recommended MPI (SLURM/PMIx integrated); the system gcc is the compiler
netcdf-c-mpi/4.9.3  # netCDF-C built against the loaded MPI; hdf5/1.14.6 comes in as a dependency
netcdf-fortran-mpi/4.6.1  # separate prefix from netcdf-c, hence NETCDFFHOME in oscar.env
parallel-netcdf-mpi/1.14.0  # for ParallelIO
