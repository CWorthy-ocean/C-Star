MPIHOME=${CRAY_MPICH_PREFIX}/
# set by cray-netcdf-hdf5parallel (verified on Perlmutter 2026-11-02)
NETCDFHOME=${CRAY_NETCDF_HDF5PARALLEL_PREFIX}/
PATH=${PATH}:${NETCDFHOME}bin
LIBRARY_PATH=${LIBRARY_PATH}:${NETCDFHOME}lib
# CUDA-aware cray-mpich: GPU-to-GPU halo exchange
MPICH_GPU_SUPPORT_ENABLED=1
GIT_DISCOVERY_ACROSS_FILESYSTEM="1"  # ensure git works on distributed file-system, e.g. lustre
