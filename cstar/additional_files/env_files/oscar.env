# Oscar (Brown CCV). The prefix variables follow spack's default `<SPEC>_ROOT`
# convention for generated module files and are UNVERIFIED on the machine as of
# 2026-11-09: after loading oscar.lmod's modules, confirm each with `module show`
# and rename as needed. A wrong name expands empty, and the pre-build toolchain
# check refuses the build naming the variable instead of linking a mixed binary.
MPIHOME=${HPCX_MPI_ROOT}
NETCDFHOME=${NETCDF_C_ROOT}
# netcdf-fortran lives in its own spack prefix, separate from netcdf-c (as on Anvil);
# the netcdf-mpi bundle in oscar.lmod only loads the two
NETCDFFHOME=${NETCDF_FORTRAN_ROOT}
PNETCDFHOME=${PARALLEL_NETCDF_ROOT}
PATH=${NETCDFHOME}/bin:${NETCDFFHOME}/bin:${PATH}
LIBRARY_PATH=${LIBRARY_PATH}:${NETCDFHOME}/lib:${NETCDFFHOME}/lib
# Linux: embed a RUNPATH at link time so the roms binary self-locates its
# libraries without needing LD_LIBRARY_PATH from loaded modules at runtime
LD_RUN_PATH=${NETCDFFHOME}/lib:${NETCDFHOME}/lib:${PNETCDFHOME}/lib:${MPIHOME}/lib
GIT_DISCOVERY_ACROSS_FILESYSTEM="1"  # ensure git works on distributed file-systems
