# Oscar (Brown CCV). Variable names from `module show` on the machine 2026-11-09.
# hpcx-mpi exports no prefix variable of its own, but sets Open MPI's OPAL_PREFIX
# (/oscar/rt/sw/external/hpcx-mpi/2.25.1/).
MPIHOME=${OPAL_PREFIX}
# The netcdf-mpi bundle sets NETCDF to its own prefix, where nc-config and nf-config
# both resolve. That its lib/ and include/ also hold both libraries is assumed, not
# yet seen; if not, use the separate prefixes `nc-config --prefix` and
# `nf-config --prefix` report.
NETCDFHOME=${NETCDF}
NETCDFFHOME=${NETCDF}
# parallel-netcdf-mpi exports no prefix variable, so this is the prefix
# `pnetcdf-config --prefix` reported (used only when ParallelIO is enabled). It goes
# stale if CCV rebuilds the module: a missing prefix fails a ParallelIO build (other
# builds only carry a dead RUNPATH entry), and a surviving old one would link ROMS
# against a different PnetCDF than ParallelIO finds on PATH.
# Switch to a variable here once the module sets one (as netcdf-mpi sets NETCDF).
PNETCDFHOME=/oscar/rt/9.6/25/spack/x86_64_v3/parallel-netcdf-1.14.0-bxuz7xw2osfunbnl46mfp3zhpq6bmnmq
PATH=${NETCDFHOME}/bin:${PATH}
LIBRARY_PATH=${LIBRARY_PATH}:${NETCDFHOME}/lib
# Linux: embed a RUNPATH at link time so the roms binary self-locates its
# libraries without needing LD_LIBRARY_PATH from loaded modules at runtime
LD_RUN_PATH=${NETCDFHOME}/lib:${PNETCDFHOME}/lib:${MPIHOME}/lib
GIT_DISCOVERY_ACROSS_FILESYSTEM="1"  # ensure git works on distributed file-systems
