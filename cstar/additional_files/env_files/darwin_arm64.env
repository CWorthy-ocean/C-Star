MPIHOME=${CONDA_PREFIX}
NETCDFHOME=${CONDA_PREFIX}
# conda provides a combined prefix: netcdf-fortran lives alongside netcdf-c
NETCDFFHOME=${CONDA_PREFIX}
PNETCDFHOME=${CONDA_PREFIX}
# No LD_LIBRARY_PATH here: dyld ignores it on macOS (and SIP strips DYLD_*);
# macOS binaries self-locate via rpaths embedded by the conda toolchain
