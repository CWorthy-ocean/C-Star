MPIHOME=${CONDA_PREFIX}
NETCDFHOME=${CONDA_PREFIX}
# conda provides a combined prefix: netcdf-fortran and pnetcdf live alongside netcdf-c
NETCDFFHOME=${CONDA_PREFIX}
PNETCDFHOME=${CONDA_PREFIX}
# Linux: embed a RUNPATH at link time so the roms binary self-locates its libraries
LD_RUN_PATH=${CONDA_PREFIX}/lib
LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${NETCDFHOME}/lib
