MPIHOME=${OPENMPI_HOME}
NETCDFHOME=${NETCDF}
# netcdf-fortran lives in its own spack prefix on Anvil (separate from netcdf-c);
# NETCDF_FORTRAN_HOME is set by the netcdf-fortran module
NETCDFFHOME=${NETCDF_FORTRAN_HOME}
PNETCDFHOME=${PNETCDF}
PATH=${NETCDFHOME}/bin:${PATH}
LIBRARY_PATH=${LIBRARY_PATH}:${NETCDFHOME}/lib:${NETCDFFHOME}/lib
# Linux: embed a RUNPATH at link time so the roms binary self-locates its
# libraries without needing LD_LIBRARY_PATH from loaded modules at runtime
LD_RUN_PATH=${NETCDFFHOME}/lib:${NETCDFHOME}/lib:${PNETCDFHOME}/lib:${MPIHOME}/lib
GIT_DISCOVERY_ACROSS_FILESYSTEM="1"  # ensure git works on distributed file-system, e.g. lustre
