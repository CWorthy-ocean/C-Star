# Package data outside the .py tree: machine env files, lmod lists, templates,
# agent skills.
# (setuptools_scm already includes tracked files; this keeps sdists built without
# git metadata complete.)
recursive-include cstar/additional_files *
recursive-include cstar/catalog/bundled *
recursive-include cstar/wizard *.yaml *.ipynb *.png

# The agent skills C-Star ships live in cstar/additional_files/skills/ (above).
# .agents/skills/ and .claude/skills/ hold links to them, for agents working in
# a checkout, plus any skills only for C-Star's contributors; neither ships.
prune .agents
prune .claude
