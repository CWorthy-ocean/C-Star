{
    "$defs": {
        "DeferredBlueprintRef": {
            "additionalProperties": false,
            "description": "A reference to a blueprint that is generated by an upstream step.\n\nThe blueprint file does not exist when the workplan is scheduled; it is\nlocated in the producing step's output directory at runtime.",
            "properties": {
                "from_step": {
                    "description": "The name of the step that generates the blueprint.",
                    "minLength": 1,
                    "title": "From Step",
                    "type": "string"
                },
                "filename": {
                    "default": "",
                    "description": "Optional name of the blueprint file within the producing step's output\ndirectory.\n\nWhen omitted, exactly one blueprint file must exist in the producing\nstep's output directory.",
                    "title": "Filename",
                    "type": "string"
                }
            },
            "required": [
                "from_step"
            ],
            "title": "DeferredBlueprintRef",
            "type": "object"
        },
        "Step": {
            "additionalProperties": false,
            "description": "An individual unit of execution within a workplan.",
            "properties": {
                "name": {
                    "description": "The user-friendly name of the step.",
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                },
                "application": {
                    "description": "The user-friendly name of the application executed in the step.",
                    "minLength": 1,
                    "title": "Application",
                    "type": "string"
                },
                "blueprint": {
                    "anyOf": [
                        {
                            "format": "file-path",
                            "type": "string"
                        },
                        {
                            "$ref": "#/$defs/DeferredBlueprintRef"
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "description": "The blueprint that will be executed in this step.\n\nA mapping with a `from_step` key defers the blueprint to one generated by\nan upstream step at runtime.",
                    "title": "Blueprint"
                },
                "depends_on": {
                    "description": "An optional list of external step names that must execute prior to this step.\n\nCycles are not permitted.",
                    "items": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "title": "Depends On",
                    "type": "array"
                },
                "blueprint_overrides": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            {
                                "additionalProperties": true,
                                "type": "object"
                            }
                        ]
                    },
                    "description": "A collection of key-value pairs specifying overrides for blueprint attributes.",
                    "title": "Blueprint Overrides",
                    "type": "object"
                },
                "compute_overrides": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            {
                                "additionalProperties": true,
                                "type": "object"
                            }
                        ]
                    },
                    "description": "A collection of key-value pairs specifying overrides for compute attributes.",
                    "title": "Compute Overrides",
                    "type": "object"
                },
                "workflow_overrides": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            {
                                "additionalProperties": true,
                                "type": "object"
                            }
                        ]
                    },
                    "description": "A collection of key-value pairs specifying overrides for workflow attributes.",
                    "title": "Workflow Overrides",
                    "type": "object"
                },
                "directives": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            {
                                "additionalProperties": true,
                                "type": "object"
                            }
                        ]
                    },
                    "description": "A collection of key-value pairs specifying configuration for runtime directives.",
                    "title": "Directives",
                    "type": "object"
                }
            },
            "required": [
                "name",
                "application",
                "blueprint"
            ],
            "title": "Step",
            "type": "object"
        },
        "WorkplanState": {
            "description": "The allowed states for a work plan.",
            "enum": [
                "notset",
                "draft",
                "validated"
            ],
            "title": "WorkplanState",
            "type": "string"
        }
    },
    "additionalProperties": false,
    "description": "A collection of executable steps and the associated configuration to run them.",
    "properties": {
        "name": {
            "description": "The user-friendly name of the workplan.",
            "minLength": 1,
            "title": "Name",
            "type": "string"
        },
        "description": {
            "description": "A user-friendly description of the workplan.",
            "minLength": 1,
            "title": "Description",
            "type": "string"
        },
        "steps": {
            "description": "The steps to be executed by the workplan.",
            "items": {
                "$ref": "#/$defs/Step"
            },
            "minItems": 1,
            "title": "Steps",
            "type": "array"
        },
        "state": {
            "$ref": "#/$defs/WorkplanState",
            "default": "notset",
            "description": "The current validation status of the workplan."
        },
        "compute_environment": {
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "boolean"
                    },
                    {
                        "type": "string"
                    },
                    {
                        "type": "number"
                    },
                    {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    {
                        "items": {
                            "type": "number"
                        },
                        "type": "array"
                    },
                    {
                        "additionalProperties": true,
                        "type": "object"
                    }
                ]
            },
            "description": "A collection of key-value pairs specifying attributes for the target compute environment.",
            "title": "Compute Environment",
            "type": "object"
        },
        "runtime_vars": {
            "description": "A collection of user-defined variables that will be populated at runtime.",
            "items": {
                "type": "string"
            },
            "title": "Runtime Vars",
            "type": "array"
        }
    },
    "required": [
        "name",
        "description",
        "steps"
    ],
    "title": "Workplan",
    "type": "object"
}
